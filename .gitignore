# Windows OS files
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS / Linux OS files (in case the repository is opened elsewhere)
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
*~
.fuse_hidden*
.directory
.nfs*

# Editor and IDE files
.vscode/
.idea/
*.swp
*.swo
*.sublime-workspace
*.code-workspace

# Office and editor lock/temporary files
~$*
*.tmp
*.temp
*.bak

# Node dependencies - restored with `npm install`, never committed.
# package-lock.json is deliberately NOT ignored: it pins the versions.
node_modules/

# Logs
*.log
logs/

# Archives and local scratch output
*.zip
*.7z
*.rar

# Credentials and secrets - never commit these
.env
.env.*
!.env.example
# inventory/.env holds the connection to the source database, including the
# password, and is covered by the .env rule above. The test suite needs no
# environment file of its own: it opens no database connection at all.
*.pem
*.key
*.pfx
*.p12
credentials.json
secrets.json
appsettings.Local.json

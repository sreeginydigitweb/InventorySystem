# Windows OS files
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS / Linux OS files (in case the repository is opened elsewhere)
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
*~
.fuse_hidden*
.directory
.nfs*

# Editor and IDE files
.vscode/
.idea/
*.swp
*.swo
*.sublime-workspace
*.code-workspace

# Office and editor lock/temporary files
~$*
*.tmp
*.temp
*.bak

# Node dependencies - restored with `npm install`, never committed.
# package-lock.json is deliberately NOT ignored: it pins the versions.
node_modules/

# Logs
*.log
logs/

# Archives and local scratch output
*.zip
*.7z
*.rar

# Credentials and secrets - never commit these
.env
.env.*
!.env.example
# NOTE: inventory/test.env is deliberately NOT ignored and must stay committed.
# It holds no credentials - only DB_SCHEMA=inventory_control_test - and it is
# what keeps the test suite off the production schema. Do not add a blanket
# *.env rule here.
*.pem
*.key
*.pfx
*.p12
credentials.json
secrets.json
appsettings.Local.json

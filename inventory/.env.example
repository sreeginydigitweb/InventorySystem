# Smart Inventory Control - database connection.
#
# Copy this file to inventory/.env and fill in the values. .env is ignored by
# git (see .gitignore); this template is not, and must never contain a real
# password, host or user.
#
# The application reads and writes ONE schema, inventory_control. It never
# touches any other schema in the database.
#
# Create the schema once with:
#   psql "<your connection>" -f sql/001-inventory-control-schema.sql
#
# There is no seed step for the application. inventory_control holds the real
# stock data; the demonstration fixture is test data and is only ever loaded
# into the separate test schema.

DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=varmen_db

# true when the server requires TLS. The certificate is self-signed, so the
# connection is encrypted but the chain is not verified - sslmode=require, not
# verify-full.
DB_SSL=true

# Optional. Connections held open in the pool. Defaults to 10.
# DB_POOL_MAX=10

# Optional. The schema the application reads and writes. Defaults to
# inventory_control.
#
# LEAVE THIS UNSET. It exists so the test suite - which empties and reseeds
# every table it touches - can be pointed at a throwaway schema instead of the
# one holding real stock. The suite sets it to inventory_control_test in
# inventory/test.env, and inventory/fixture/load.js refuses to delete or seed
# anything when it is inventory_control.
# DB_SCHEMA=inventory_control

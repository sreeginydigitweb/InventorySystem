# Smart Inventory Control - connection to the source database.
#
# Copy this file to inventory/.env and fill in the values. .env is ignored by
# git (see .gitignore); this template is not, and must never contain a real
# password, host or user.
#
# ---------------------------------------------------------------------------
# THIS CONNECTION IS READ-ONLY, AND MUST STAY THAT WAY
#
# `ledsone` is an existing business database. This application reports on it and
# never writes to it. Three things keep that true, and all three are in place:
#
#   1. Every statement in the codebase is a SELECT. There is no INSERT, UPDATE,
#      DELETE, CREATE, ALTER, DROP or TRUNCATE anywhere in it, and no add, edit
#      or delete screen to reach one from.
#
#   2. The pool sets `default_transaction_read_only = on` as a connection
#      option, so the SERVER refuses a write on this connection regardless of
#      what the application asks for.
#
#   3. DB_USER below should be a role with SELECT and nothing else on the
#      schemas named at the foot of this file. The application checks this at
#      startup and REFUSES TO START if the role turns out to hold INSERT,
#      UPDATE or DELETE on inventory.products.
#
# Point DB_USER at a role that can write, and the application will stop rather
# than run. That is deliberate.
#
# There is no schema to create, no migration to run and no seed step. The
# source database already holds the data; this application only reads it.

DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=

# The source database. This is the one holding the real stock - not the
# application's own, because it does not have one.
DB_NAME=ledsone

# true when the server requires TLS. The certificate is self-signed, so the
# connection is encrypted but the chain is not verified - sslmode=require, not
# verify-full.
DB_SSL=true

# Optional. Connections held open in the pool. Defaults to 3.
#
# Keep it small. This role is shared with the other applications on this server
# and has one connection limit covering all of them, so an oversized pool here
# can exhaust the role and refuse every application a connection - this one
# included, at startup. Raise it only against a role of its own.
# DB_POOL_MAX=3

# Optional. The schemas read. The defaults are the real ones and there is no
# reason to change them outside a test rig.
#
#   DB_INVENTORY_SCHEMA  products, warehouses, physical stock, images
#   DB_SUPPLIERS_SCHEMA  purchase orders, for the supplier shown against a SKU
#   DB_ORDERS_SCHEMA     sales orders, for units sold in the last 90 days
#
# DB_INVENTORY_SCHEMA=inventory
# DB_SUPPLIERS_SCHEMA=suppliers
# DB_ORDERS_SCHEMA=order_management

# Optional. How long a read is reused before the source is asked again, in
# milliseconds. Defaults to 60000.
#
# The catalogue is thousands of SKUs and tens of thousands of stock lines, so
# every screen sharing one read per minute is the difference between a page that
# appears and a page that waits. Nothing is written back, so the figures can
# only ever be up to this far behind - never wrong in a way a refresh will not
# fix. Set it to 0 to read the source on every single request.
# INVENTORY_CACHE_MS=60000
